{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bynefit/quote",
    "version": "0.1.0",
    "title": "Bynefit Quote",
    "category": "text",
    "icon": "format-quote",
    "description": "A pull quote or testimonial with attribution and an optional avatar, styled from the theme's tokens.",
    "textdomain": "bynli-connect",
    "supports": {
        "html": false,
        "anchor": true,
        "align": ["wide"]
    },
    "attributes": {
        "text": { "type": "string", "default": "" },
        "cite": { "type": "string", "default": "" },
        "role": { "type": "string", "default": "" },
        "avatar": { "type": "object" },
        "align": { "type": "string", "default": "start" }
    },
    "render": "file:./render.php",
    "style": "bynefit-blocks"
}
